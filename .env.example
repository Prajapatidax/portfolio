# ==============================================================================
# DAX PRAJAPATI PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Neon PostgreSQL Database
# Format: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# If left empty in local dev, will fallback gracefully to SQLite (instance/portfolio.db)
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Initial Admin Credentials (used to seed initial admin user if not already present)
ADMIN_NAME=Dax Prajapati
ADMIN_EMAIL=admin@prajapatidax.co.in
ADMIN_PASSWORD=AdminSecurePassword2026!

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Security & Session Settings
SESSION_COOKIE_SECURE=False
PERMANENT_SESSION_LIFETIME=86400

# Neon Object Storage (S3-compatible)
NEON_STORAGE_BUCKET=photos
AWS_ACCESS_KEY_ID=your_neon_storage_access_key
AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_key
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint.aws.neon.tech
AWS_REGION=ap-southeast-1
